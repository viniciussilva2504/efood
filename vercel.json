    {
    "buildCommand": "react-scripts build",
    "outputDirectory": "build",
    "framework": "create-react-app",
    "rewrites": [
        {
        "source": "/(.*)",
        "destination": "/index.html"
        }
    ],
    "headers": [
        {
        "source": "/service-worker.js",
        "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
        }
    ]
    }